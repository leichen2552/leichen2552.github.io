            <% if (site.customConfig.update == "on") { %>
                <div id="version" style="display:none;">
                    <%- site.customConfig.version%>
                </div>
                <%}%>
                    <script>
                        var port = '';
                        <% if (site.customConfig.live2dDebug == "on") { %>
                        port = ':4000';
                        <%}%>
                        document.write('<div id="home_path" style="display:none;">' + document.location.protocol + '//' + window.document.location.hostname + port + '</div>')
                    </script>
        </footer>
        <% if (site.customConfig.live2d == "on") { %>
            <script src='https://cdn.jsdelivr.net/npm/live2d-widget@3.x/lib/L2Dwidget.min.js'></script>
            <% } %>
                <script>
                    <% if (site.customConfig.music == "on") { %>
                    const musicList = <%- JSON.stringify(site.customConfig.musics.map(function(music) {
                        return { name: music.name, url: music.url, artist: music.author, cover: music.pic };
                    })).replace(/</g, '\\u003c') %>;

                    function loadMusicAsset(tagName, attributes) {
                        return new Promise(function(resolve, reject) {
                            const element = document.createElement(tagName);
                            Object.keys(attributes).forEach(function(name) {
                                element[name] = attributes[name];
                            });
                            element.onload = resolve;
                            element.onerror = reject;
                            document.head.appendChild(element);
                        });
                    }

                    function loadMusicPlayer() {
                        const launcher = document.getElementById('music-launcher');
                        launcher.disabled = true;
                        launcher.setAttribute('aria-expanded', 'true');

                        return Promise.all([
                            loadMusicAsset('link', { rel: 'stylesheet', href: '/media/css/APlayer.min.css' }),
                            window.APlayer
                                ? Promise.resolve()
                                : loadMusicAsset('script', { src: '/media/script/APlayer.min.js', async: true })
                        ]).then(function() {
                            new APlayer({
                                container: document.getElementById('player'),
                                fixed: true,
                                autoplay: false,
                                preload: "none",
                                audio: musicList
                            });
                            launcher.remove();
                        }).catch(function() {
                            launcher.disabled = false;
                            launcher.setAttribute('aria-expanded', 'false');
                            launcher.textContent = '音乐加载失败';
                        });
                    }

                    document.getElementById('music-launcher').addEventListener('click', loadMusicPlayer, { once: true });
                    <% } %>
                    <% if (site.customConfig.live2d == "on") { %>
                    loadlive2d();
                    <% } %>
                    <% if (site.customConfig.sentence == "on") { %>
                    hitokoto();
                    <% } if (site.customConfig.icpcode != "") {  if (site.customConfig.icpinfo != "") { %>
                    var icp = document.getElementById('icpinfo');
                    icp.innerText = "<%= site.customConfig.icpinfo%>";
                    <%} }%>
                    getStar();
                    hljs.initHighlighting();
                    console.clear();
                    <% if (site.customConfig.update == "on") { %>
                    CheckVersion();
                    <%}%>
                    var newDate = new Date();
                    newDate.setTime(<%=site.utils.now%>);
                    console.log(" Blog Update Time: " + newDate.toLocaleDateString());
                    console.log("\n %c \u26a1Theme:Chic Author's Blog:https://blog.itjoker.cn  Write By ITJoker  \n\n", "color: #ffffff; background: rgba(49, 49, 49, 0.85); padding:5px 0;border-radius:5px;");
                </script>
